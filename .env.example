# Copy this file to .env and replace the password before running Docker Compose.
DB_NAME=household_db
DB_USER=household_user
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/household_db

DB_MAXIMUM_POOL_SIZE=10
DB_MINIMUM_IDLE=1
DB_CONNECTION_TIMEOUT_MILLIS=30000

# Enable only for the first migration of a database created by the legacy application.
DB_BASELINE_ON_MIGRATE=false
